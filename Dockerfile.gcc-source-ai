FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    GCC_VERSION=16.2.0 \
    TERM=xterm-256color \
    EDITOR=vim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential binutils bison flex make cmake ninja-build \
    gdb git vim less file wget curl ca-certificates gnupg \
    xz-utils bzip2 gzip tar unzip patch diffutils pkg-config \
    python3 python3-pip perl texinfo gawk \
    libgmp-dev libmpfr-dev libmpc-dev libisl-dev \
    zlib1g-dev libzstd-dev \
    && rm -rf /var/lib/apt/lists/*

# Node.js para Codex e OpenCode.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/node-setup.sh \
    && bash /tmp/node-setup.sh \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -f /tmp/node-setup.sh \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @openai/codex @opencode/cli \
    && npm cache clean --force

WORKDIR /usr/src

# Baixa o repositório gcc-omp-transaction via wget, descompacta o fluxo e salva em .tar.xz
RUN wget -qO- https://github.com/GersonCavalheiro/gcc-omp-transaction/archive/refs/heads/main.tar.gz | zcat | xz -c > gcc-omp-transaction.tar.xz \
    && tar -xf gcc-omp-transaction.tar.xz \
    && mv gcc-omp-transaction-main gcc-omp-transaction \
    && rm gcc-omp-transaction.tar.xz \
    && mkdir -p /usr/src/gcc-build

# README é incluído na imagem; não executa configure/make/install.
COPY README.md /usr/src/README.md

WORKDIR /usr/src/gcc-build
CMD ["/bin/bash"]
