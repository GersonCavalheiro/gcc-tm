
# ============================================================
# GCC Transaction Development Environment
#
# Base: Ubuntu 24.04
# GCC: fontes fornecidos pelo host (bind mount)
# Agentes: Codex, OpenCode e Claude Code
#
# Os fontes e os resultados da compilação permanecem no host.
# ============================================================

FROM ubuntu:24.04

# ============================================================
# 1. Configuração geral
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive \
    TERM=xterm-256color \
    EDITOR=vim

# ============================================================
# 2. Dependências fundamentais do GCC
# ============================================================

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        bison \
        flex \
        libgmp-dev \
        libmpfr-dev \
        libmpc-dev \
        libisl-dev \
        zlib1g-dev \
        python3 \
        perl \
        texinfo \
        gawk \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# 3. Ferramentas de desenvolvimento
# ============================================================

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gdb \
        git \
        vim \
        less \
        curl \
        ca-certificates \
        gnupg \
        xz-utils \
        diffutils \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# 4. Instalação do Node.js 22
# ============================================================

RUN curl -fsSL https://deb.nodesource.com/setup_22.x \
        -o /tmp/node-setup.sh \
    && bash /tmp/node-setup.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        nodejs \
    && rm -f /tmp/node-setup.sh \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# 5. Instalação dos agentes
#
# Instalação global realizada como root.
# Os executáveis ficam disponíveis para todos os usuários.
# ============================================================

# Codex
RUN npm install -g @openai/codex \
    && npm cache clean --force

# OpenCode
RUN npm install -g opencode-ai \
    && npm cache clean --force

# Claude Code
RUN npm install -g @anthropic-ai/claude-code \
    && npm cache clean --force

# ============================================================
# 6. Configuração do usuário não privilegiado
#
# Ubuntu 24.04 possui o usuário ubuntu (UID 1000).
# ============================================================

RUN mkdir -p /usr/src/gcc-tm \
    && chown ubuntu:ubuntu /usr/src/gcc-tm

ENV HOME=/home/ubuntu \
    PATH="/home/ubuntu/.local/bin:${PATH}"

USER ubuntu

# ============================================================
# 7. Diretório de trabalho
#
# O projeto é montado a partir da máquina hospedeira.
# ============================================================

WORKDIR /usr/src/gcc-tm

# ============================================================
# 8. Comando padrão
# ============================================================

CMD ["/bin/bash"]

